{
  "manifest_version": 3,
  "name": "RRB Exam Result Analyzer",
  "version": "1.1.0",
  "description": "Analyzes RRB exam response sheets and displays result statistics.",
  "content_scripts": [
    {
      "matches": ["https://rrb.digialm.com/*"],
      "js": ["main.min.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://rrb.digialm.com/*"],
      "js": ["content.min.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
